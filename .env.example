#
# Every setting of the proxy, with the value the compose file reads from .env. Unset means the default in
# docs/configuration.md. Copy to .env (never commit it) and fill in at least REDIS_PASSWORD.

# --- Redis ---------------------------------------------------------------------------------------------------------
# Required by docker-compose.yml. Generate one, do not invent it:  openssl rand -base64 32
# The proxy adds it to REDIS_URL percent-encoded, so any character is allowed. Keep it in a secret store, not in git.
REDIS_PASSWORD=
# compose already points at its own Redis (redis://redis:6379). Outside Docker set it here (one of the two password
# forms only: a password in both REDIS_URL and REDIS_PASSWORD is refused).
# REDIS_URL=
# Namespace for every key. Unset derives one from UPSTREAM_URL (or the tunnel key), so two proxies for two servers can
# share one Redis safely. Set it to share cache and counters between proxies that serve the same server.
# REDIS_KEY_PREFIX=

# --- Connections ---------------------------------------------------------------------------------------------------
# The plugin's REST and live ports, as seen from the container. Not used with the reverse tunnel.
# The compose default is http://host.docker.internal:1553 (the plugin on the Docker host).
# UPSTREAM_URL=http://host.docker.internal:1553
# UPSTREAM_LIVE_URL=http://host.docker.internal:1554
# Pairing, token check and revocation feed; see docs/tunnel.md.
TUNNEL_TOKEN=
TUNNEL_ALLOWED_IPS=
TUNNEL_PATH=/tunnel
TUNNEL_DEAD_S=60
EVENTS_TOKEN=
# Webhook receiver: a shared secret of 16+ characters, the port to listen on (0 = off) and how far its timestamp may drift.
WEBHOOK_SECRET=
WEBHOOK_PORT=0
WEBHOOK_HOST=127.0.0.1
WEBHOOK_TOLERANCE_S=300
REVOCATION_TTL_S=3600
# Public listener (put TLS in front) and the operational endpoints (/healthz, /readyz, /tunnelz, /metrics).
# ADMIN_PORT=0 turns the admin listener off; never publish it.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
ADMIN_HOST=127.0.0.1
ADMIN_PORT=9090

# --- Client identity -----------------------------------------------------------------------------------------------
# Addresses/CIDRs of your TLS terminator or CDN; only they may set X-Forwarded-For.
TRUSTED_PROXIES=

# --- Token check ---------------------------------------------------------------------------------------------------
# The base64 text of the plugin's plugins/MCDashboard/secret.key. With it the proxy verifies tokens and caches
# authenticated answers per player; without it tokens are forwarded unchecked and authenticated answers are not cached.
MCD_JWT_SECRET=

# --- Rate limits (per client, per window) --------------------------------------------------------------------------
RATE_WINDOW_S=60
RATE_READ=300
RATE_AUTH=10
RATE_WRITE=6
RATE_BAD_TOKEN=20
MAX_CONCURRENT_PER_IP=20
MAX_LIVE_PER_IP=5
MAX_LIVE_TOTAL=500

# --- Protecting the plugin -----------------------------------------------------------------------------------------
MAX_UPSTREAM_CONCURRENCY=32
UPSTREAM_TIMEOUT_MS=5000
MAX_BODY_BYTES=32768
MAX_URL_LENGTH=4096

# --- Cache ---------------------------------------------------------------------------------------------------------
# Languages the plugin supports; Accept-Language is reduced to these before it becomes part of a cache key.
LANGUAGES=en,nl,fr,de,es
STALE_IF_ERROR_S=300
NEGATIVE_TTL_S=5
CACHE_MAX_BODY_BYTES=524288
# How many new entries one client may add per five minutes; protects the shared cache from being filled.
MAX_CACHE_KEYS_PER_CLIENT=256
