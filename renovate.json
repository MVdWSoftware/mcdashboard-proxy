{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", "schedule:weekly"],
  "timezone": "Europe/Brussels",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchPackageNames": ["nginx", "nginxinc/nginx-unprivileged"],
      "matchDatasources": ["docker"],
      "schedule": ["at any time"],
      "description": "nginx ships security fixes (e.g. nginx2root) out of band: do not wait for the weekly window."
    }
  ]
}
